{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experience",
  "description": "Companies and roles. Rendered newest-first by start date, so array order does not matter.",
  "type": "object",
  "required": ["experience"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["company", "role", "start", "end"],
        "additionalProperties": false,
        "properties": {
          "company": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "url": { "type": ["string", "null"], "pattern": "^https://" },
          "start": { "type": "string", "pattern": "^\\d{4}(-\\d{2})?$", "description": "YYYY or YYYY-MM" },
          "end": { "type": ["string", "null"], "pattern": "^\\d{4}(-\\d{2})?$", "description": "YYYY or YYYY-MM, or null for present" },
          "note": { "type": "string", "description": "Optional one-liner shown under the role." }
        }
      }
    }
  }
}
